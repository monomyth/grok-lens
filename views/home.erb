<% @title = "Grok Lens" %>

<% if @snap.missing_home %>
  <section class="empty">
    <h1>No Grok home found</h1>
    <p>Looked for <code><%= h(@snap.grok_home) %></code>. Set <code>GROK_HOME</code> if your data lives elsewhere.</p>
  </section>
<% else %>

<section class="stats-strip" id="stats-strip">
  <div class="stat">
    <div class="label">Live sessions</div>
    <div class="value num" id="stat-live"><%= @snap.active_sessions.count { |s| s.active? } %></div>
    <div class="sub"><span id="stat-stale"><%= @snap.active_sessions.count(&:stale?) %></span> stale · <span id="stat-running-total"><%= @snap.primary_sessions.sum(&:running_count) %></span> tasks</div>
  </div>
  <div class="stat">
    <div class="label">Est. tokens</div>
    <div class="value num" id="stat-tokens"><%= est(@snap.total_est_tokens) %></div>
    <div class="sub"><% if cost_enabled? %>est. cost <span id="stat-cost"><%= cost_label(@snap.total_est_tokens) %></span><% else %>lifetime proxy · hybrid<% end %></div>
  </div>
  <div class="stat">
    <div class="label">Primary sessions</div>
    <div class="value num" id="stat-sessions"><%= @snap.primary_sessions.size %></div>
    <div class="sub"><%= @snap.primary_sessions.count(&:grok?) %> grok · <%= @snap.primary_sessions.count(&:bot?) %> bot · <%= @snap.sessions_by_id.size %> incl. nested</div>
  </div>
  <div class="stat">
    <div class="label">Models</div>
    <div class="model-list" id="stat-models"><%= model_bars(@snap.models_hist) %></div>
  </div>
</section>

<section class="block" id="active-block"<%= @snap.active_sessions.any? ? "" : " hidden" %>>
  <h2 class="section-title">Active now</h2>
  <table class="ledger" id="active-table">
    <thead>
      <tr>
        <th>Status</th>
        <th>Project</th>
        <th>Title</th>
        <th>Model</th>
        <th class="r">Running</th>
        <th class="r">Turns</th>
        <th class="r">Est. tok</th>
      </tr>
    </thead>
    <tbody id="active-tbody">
      <% @snap.active_sessions.each do |s| %>
        <tr data-id="<%= h(s.id) %>">
          <td><span class="dot <%= s.status %>"></span><%= status_label(s.status) %><% if s.pid %> <span class="muted">pid <%= s.pid %></span><% end %></td>
          <td class="mono"><%= h(File.basename(s.cwd.to_s)) %></td>
          <td>
            <a href="/sessions/<%= h(s.id) %>"><%= h(s.title) %></a>
            <span class="badge src"><%= h(s.source_label) %></span>
            <% if s.children.any? %>
              <span class="badge">+<%= s.children.size %> sub<% if s.live_children_count.positive? %> · <%= s.live_children_count %> live<% end %></span>
            <% end %>
            <% if s.running_count.positive? %><span class="badge live-tasks"><%= s.running_count %> running</span><% end %>
            <div class="row actions">
              <button type="button" class="btn small" data-copy-text="<%= h(s.id) %>">Id</button>
              <button type="button" class="btn small" data-copy-text="<%= h(resume_command(s)) %>">Resume</button>
            </div>
          </td>
          <td><%= h(s.current_model_id || s.models.first) %></td>
          <td class="r num running-cell"><%= s.running_count.positive? ? s.running_count : "—" %></td>
          <td class="r num"><%= s.num_turns %></td>
          <td class="r num"><%= est(s.est_tokens) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<section class="dual">
  <div class="col">
    <h2 class="section-title">Projects</h2>
    <div id="projects-list">
    <% if @snap.projects.empty? %>
      <p class="muted">No projects found.</p>
    <% end %>
    <% @snap.projects.each do |p| %>
      <article class="project-card">
        <div class="row">
          <h3><a href="/projects/<%= h(p.id) %>"><%= h(p.name) %></a></h3>
          <span class="muted num"><%= p.session_count %> sess · <%= est(p.est_tokens) %></span>
        </div>
        <div class="mono path"><%= h(short_path(p.path)) %></div>
        <p class="desc"><%= h(p.description) %></p>
        <div class="model-list compact"><%= model_bars(p.models_hist) %></div>
      </article>
    <% end %>
    </div>
  </div>

  <div class="col">
    <div class="row between wrap">
      <h2 class="section-title">Sessions</h2>
      <div class="toolbar">
        <form method="get" action="/" class="inline toolbar-form">
          <% unless @src.to_s.empty? %><input type="hidden" name="src" value="<%= h(@src) %>"><% end %>
          <div class="chips" role="navigation" aria-label="Source">
            <a class="chip<%= @src.to_s.empty? ? " on" : "" %>" href="<%= home_query(sort: @sort, running: @filter_running) %>">All</a>
            <a class="chip<%= @src == "grok" ? " on" : "" %>" href="<%= home_query(src: "grok", sort: @sort, running: @filter_running) %>">Grok Build</a>
            <a class="chip<%= @src == "bot" ? " on" : "" %>" href="<%= home_query(src: "bot", sort: @sort, running: @filter_running) %>">Grok Bot</a>
          </div>
          <select name="sort" aria-label="Sort sessions" onchange="this.form.submit()">
            <option value="last_active" <%= @sort == "last_active" ? "selected" : "" %>>Last active</option>
            <option value="running" <%= @sort == "running" ? "selected" : "" %>>Running tasks</option>
            <option value="tokens" <%= @sort == "tokens" ? "selected" : "" %>>Est. tokens</option>
            <option value="title" <%= @sort == "title" ? "selected" : "" %>>Title</option>
          </select>
          <label class="check">
            <input type="checkbox" name="running" value="1" <%= @filter_running ? "checked" : "" %> onchange="this.form.submit()">
            Running only
          </label>
        </form>
        <input type="search" id="filter" class="filter" placeholder="Filter…" aria-label="Filter sessions">
      </div>
    </div>
    <table class="ledger" id="recent-sessions">
      <thead>
        <tr>
          <th>Age</th>
          <th>Session</th>
          <th class="r">Run</th>
          <th class="r">Est. tok</th>
        </tr>
      </thead>
      <tbody id="recent-tbody">
        <% @sorted_sessions.each do |s| %>
          <tr data-id="<%= h(s.id) %>" data-filter="<%= h("#{s.title} #{s.cwd} #{s.current_model_id} #{s.id} #{s.source_label} #{s.bot_section}") %>" data-running="<%= s.running_count %>" data-tokens="<%= s.est_tokens %>" data-source="<%= h(s.source_key) %>">
            <td class="age muted num"><%= relative_time(s.last_active_at) %></td>
            <td>
              <a href="/sessions/<%= h(s.id) %>"><%= h(s.title) %></a>
              <span class="badge src"><%= h(s.source_label) %></span>
              <% if s.children.any? %>
                <span class="badge">+<%= s.children.size %> sub<% if s.live_children_count.positive? %> · <%= s.live_children_count %> live<% end %></span>
              <% end %>
              <% if s.running_count.positive? %><span class="badge live-tasks"><%= s.running_count %> running</span><% end %>
              <div class="subline muted"><%= h(s.bot? ? (s.bot_section || "Grok Bot") : File.basename(s.cwd.to_s)) %> · <%= h(s.current_model_id || (s.bot? ? "bot" : nil)) %> · <%= s.num_turns %> turns<% if s.context_tokens %> · ctx <%= est(s.context_tokens) %><% end %></div>
              <div class="row actions">
                <button type="button" class="btn small" data-copy-text="<%= h(s.id) %>">Id</button>
                <button type="button" class="btn small" data-copy-text="<%= h(resume_command(s)) %>">Resume</button>
                <a class="btn small" href="/compare?a=<%= h(s.id) %>">Compare</a>
              </div>
            </td>
            <td class="r num running-cell"><%= s.running_count.positive? ? s.running_count : "—" %></td>
            <td class="r num"><%= est(s.est_tokens) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<% end %>
