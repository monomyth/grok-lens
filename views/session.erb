<% @title = "#{@session.title} · Grok Lens" %>

<% project = @snap.projects.find { |p| p.path == @session.cwd } %>
<nav class="crumb">
  <a href="/">Home</a>
  <% if project %>
    · <a href="/projects/<%= h(project.id) %>"><%= h(project.name) %></a>
  <% end %>
  · session
</nav>

<header class="detail-header">
  <div class="row">
    <span class="dot <%= @session.status %>"></span>
    <span class="status-text"><%= status_label(@session.status) %></span>
    <span class="badge src"><%= h(@session.source_label) %></span>
    <% if @session.session_kind %><span class="badge"><%= h(@session.session_kind) %></span><% end %>
    <% if @session.agent_name && @session.agent_name != @session.title %><span class="badge"><%= h(@session.agent_name) %></span><% end %>
    <% if @session.bot_section %><span class="badge"><%= h(@session.bot_section) %></span><% end %>
  </div>
  <h1><%= h(@session.title) %></h1>
  <p class="mono path"><%= h(short_path(@session.cwd)) %></p>
  <% if @session.summary_text && !@session.summary_text.empty? && @session.summary_text != @session.title %>
    <p class="desc"><%= h(@session.summary_text) %></p>
  <% end %>

  <div class="meta-grid">
    <div><span class="label">Model</span><span><%= h(@session.current_model_id) %></span></div>
    <div><span class="label">Models used</span><span><%= h(@session.models.join(", ")) %></span></div>
    <div><span class="label"><%= @session.billed? ? "Tokens" : "Est. tokens" %></span><span class="num"><%= tok(@session) %></span><div class="subline muted"><%= h(token_source_label(@session)) %></div></div>
    <div><span class="label">Context</span><span class="num"><%= ctx_label(@session) %></span></div>
    <% usd = session_cost_usd(@session); kind = session_cost_kind(@session) %>
    <% if usd %>
    <div><span class="label"><%= kind == "billed" ? "Cost" : (kind == "recorded" ? "Recorded cost" : "Est. cost") %></span><span class="num"><%= usd_label(usd) %></span></div>
    <% end %>
    <div><span class="label">Disk</span><span class="num"><%= bytes(@session.disk_bytes) %></span></div>
    <div><span class="label">Running</span><span class="num"><%= @session.running_count %></span></div>
    <div><span class="label">Subagents</span><span class="num"><%= @session.children.size %><% if @session.live_children_count.positive? %> (<%= @session.live_children_count %> live)<% end %></span></div>
    <div><span class="label">Turns</span><span class="num"><%= @session.num_turns %></span></div>
    <div><span class="label">Messages</span><span class="num"><%= @session.num_messages %></span></div>
    <div><span class="label">Chat msgs</span><span class="num"><%= @session.num_chat_messages %></span></div>
    <div><span class="label">Created</span><span class="num"><%= @session.created_at&.strftime("%Y-%m-%d %H:%M UTC") || "—" %></span></div>
    <div><span class="label">Last active</span><span class="num"><%= @session.last_active_at&.strftime("%Y-%m-%d %H:%M UTC") || "—" %></span></div>
    <% if @session.pid %><div><span class="label">PID</span><span class="num"><%= @session.pid %></span></div><% end %>
    <% if @session.git_branch %><div><span class="label">Branch</span><span class="mono"><%= h(@session.git_branch) %></span></div><% end %>
    <% if @session.git_commit %><div><span class="label">Commit</span><span class="mono"><%= h(@session.git_commit[0, 10]) %></span></div><% end %>
  </div>

  <div class="copy-panel compact">
    <div class="copy-row">
      <code class="copy-value" id="session-id"><%= h(@session.id) %></code>
      <button type="button" class="btn small" data-copy-text="<%= h(@session.id) %>">Copy id</button>
    </div>
    <% if (cmd = resume_command(@session)) %>
    <div class="copy-row">
      <code class="copy-value mono" id="resume-cmd"><%= h(cmd) %></code>
      <button type="button" class="btn small" data-copy-text="<%= h(cmd) %>">Copy resume</button>
    </div>
    <% end %>
    <% if (ucmd = usage_command(@session)) %>
    <div class="copy-row">
      <code class="copy-value mono" id="usage-cmd"><%= h(ucmd) %></code>
      <button type="button" class="btn small" data-copy-text="<%= h(ucmd) %>">Copy usage</button>
    </div>
    <% end %>
  </div>
</header>

<% if @session.recorded_usage? %>
<% u = @session.usage %>
<section class="block">
  <h2 class="section-title">Recorded usage</h2>
  <p class="desc">
    From <span class="mono">usage.json</span>
    <% if u[:incomplete] %>
      · partial — <%= u[:recorded_turns] %> of <%= @session.num_turns %> turns (ledger started mid-session)
    <% elsif u[:recorded_turns].to_i.positive? %>
      · <%= u[:recorded_turns] %> turns
    <% end %>
    <% if u[:primary_model_id] %> · <%= h(u[:primary_model_id]) %><% end %>
    <% if u[:model_calls].to_i.positive? %> · <%= u[:model_calls] %> calls<% end %>
  </p>
  <p class="usage-break num">
    <% if u[:input_tokens].to_i.positive? %><span>in <%= est(u[:input_tokens], approx: false) %></span><% end %>
    <% if u[:output_tokens].to_i.positive? %><span>out <%= est(u[:output_tokens], approx: false) %></span><% end %>
    <% if u[:cached_read_tokens].to_i.positive? %><span>cache read <%= est(u[:cached_read_tokens], approx: false) %></span><% end %>
    <% if u[:cache_creation_tokens].to_i.positive? %><span>cache write <%= est(u[:cache_creation_tokens], approx: false) %></span><% end %>
    <% if u[:reasoning_tokens].to_i.positive? %><span>reasoning <%= est(u[:reasoning_tokens], approx: false) %></span><% end %>
    <% if u[:total_tokens].to_i.positive? %><span>total <%= est(u[:total_tokens], approx: false) %></span><% end %>
    <% if u[:cost_usd] %><span><%= usd_label(u[:cost_usd]) %></span><% end %>
  </p>
  <% if Array(u[:turns]).any? %>
  <table class="ledger compact">
    <thead>
      <tr>
        <th class="r">Turn</th>
        <th>Ended</th>
        <th class="r">In</th>
        <th class="r">Out</th>
        <th class="r">Cache</th>
        <th class="r">Total</th>
        <th class="r">Cost</th>
      </tr>
    </thead>
    <tbody>
      <% Array(u[:turns]).each do |t| %>
        <tr>
          <td class="r num"><%= t[:turn_number] %></td>
          <td class="muted num"><%= t[:ended_at].to_s[0, 19] %></td>
          <td class="r num"><%= est(t[:input_tokens], approx: false) %></td>
          <td class="r num"><%= est(t[:output_tokens], approx: false) %></td>
          <td class="r num"><%= t[:cached_read_tokens].to_i.positive? ? est(t[:cached_read_tokens], approx: false) : "—" %></td>
          <td class="r num"><%= est(t[:total_tokens], approx: false) %></td>
          <td class="r num"><%= t[:cost_usd] ? usd_label(t[:cost_usd]) : "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% end %>
</section>
<% end %>

<% mcp_here = Array(@snap.mcp_servers).select { |m| Array(@session.mcp_names).include?(m.name) } %>
<% if mcp_here.any? %>
<section class="block">
  <h2 class="section-title">MCP servers <span class="muted num">(<%= mcp_here.size %>)</span></h2>
  <table class="ledger compact">
    <thead>
      <tr>
        <th>Status</th>
        <th>Server</th>
        <th>Transport</th>
        <th class="r">Tools</th>
      </tr>
    </thead>
    <tbody>
      <% mcp_here.each do |m| %>
        <tr>
          <td><span class="dot <%= h(m.status) %>"></span><%= mcp_status_label(m.status) %></td>
          <td>
            <a href="/mcp" class="mono"><%= h(m.name) %></a>
            <% if m.error %><div class="subline warn"><%= h(m.error) %></div><% end %>
          </td>
          <td><%= h(m.transport) %></td>
          <td class="r num"><%= m.tool_count.to_i.positive? ? m.tool_count : "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
<% end %>

<% if @session.running_count.positive? %>
<section class="block">
  <h2 class="section-title">Running now <span class="muted num">(<%= @session.running_count %>)</span></h2>
  <table class="ledger">
    <thead>
      <tr>
        <th>Kind</th>
        <th>Task</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% @session.running_tasks.select(&:live).each do |t| %>
        <tr>
          <td><span class="badge"><%= h(t.kind) %></span></td>
          <td>
            <%= h(t.title) %>
            <% if t.tool_name %><div class="subline muted mono"><%= h(t.tool_name) %></div><% end %>
          </td>
          <td><span class="dot active"></span><%= h(t.status) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
<% end %>

<% if @session.first_user_prompt && !@session.first_user_prompt.empty? %>
<section class="block">
  <h2 class="section-title">Opening message</h2>
  <blockquote class="prompt"><%= h(@session.first_user_prompt) %></blockquote>
</section>
<% end %>

<section class="split-detail">
  <div>
    <h2 class="section-title">Tool calls</h2>
    <%= tool_bars(@session.tool_counts) %>
  </div>
  <div>
    <h2 class="section-title">Activity</h2>
    <% if @session.activity_points.any? %>
      <div class="spark-wrap"><%= sparkline_svg(@session.activity_points, width: 280, height: 40) %></div>
      <p class="muted sub">Event density across the session (sparkline, not wall-clock).</p>
    <% else %>
      <p class="muted">No event timeline available.</p>
    <% end %>
  </div>
</section>

<% if @session.children.any? %>
<section class="block">
  <h2 class="section-title">Subagents</h2>
  <table class="ledger">
    <thead>
      <tr>
        <th>Title</th>
        <th>Model</th>
        <th class="r">Msgs</th>
        <th class="r">Tokens</th>
      </tr>
    </thead>
    <tbody>
      <% @session.children.each do |c| %>
        <tr>
          <td><a href="/sessions/<%= h(c.id) %>"><%= h(c.title) %></a></td>
          <td><%= h(c.current_model_id) %></td>
          <td class="r num"><%= c.num_messages %></td>
          <td class="r num"><%= tok(c) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
<% end %>

<p class="note muted">Skim view only — full transcripts are not loaded (some sessions exceed hundreds of MB).</p>
