<% @title = "#{@project.name} · Grok Lens" %>

<nav class="crumb"><a href="/">Home</a> · project</nav>

<header class="detail-header">
  <h1><%= h(@project.name) %></h1>
  <p class="mono path"><%= h(short_path(@project.path)) %></p>
  <p class="desc"><%= h(@project.description) %></p>
  <div class="meta-grid">
    <div><span class="label">Sessions</span><span class="num"><%= @project.session_count %></span></div>
    <div><span class="label"><%= @project.billed_tokens.to_i.positive? && @project.billed_tokens == @project.est_tokens ? "Tokens" : "Est. tokens" %></span><span class="num"><%= project_tokens_label(@project) %></span></div>
    <div><span class="label">Disk</span><span class="num"><%= bytes(@project.disk_bytes) %></span></div>
    <div><span class="label">Last active</span><span class="num"><%= relative_time(@project.last_active_at) %></span></div>
  </div>
  <div class="model-list"><%= model_bars(@project.models_hist) %></div>
</header>

<section class="block">
  <h2 class="section-title">Sessions</h2>
  <table class="ledger">
    <thead>
      <tr>
        <th>Status</th>
        <th>Title</th>
        <th>Model</th>
        <th class="r">Turns</th>
        <th class="r">Msgs</th>
        <th class="r">Tokens</th>
        <th class="r">Active</th>
      </tr>
    </thead>
    <tbody>
      <% @project.sessions.each do |s| %>
        <tr>
          <td><span class="dot <%= s.status %>"></span><%= status_label(s.status) %></td>
          <td>
            <a href="/sessions/<%= h(s.id) %>"><%= h(s.title) %></a>
            <% if s.children.any? %><span class="badge">+<%= s.children.size %> sub</span><% end %>
          </td>
          <td><%= h(s.current_model_id) %></td>
          <td class="r num"><%= s.num_turns %></td>
          <td class="r num"><%= s.num_messages %></td>
          <td class="r num"><%= tok(s) %></td>
          <td class="r muted num"><%= relative_time(s.last_active_at) %></td>
        </tr>
        <% s.children.each do |c| %>
          <tr class="child">
            <td></td>
            <td class="nested"><a href="/sessions/<%= h(c.id) %>"><%= h(c.title) %></a> <span class="badge">subagent</span></td>
            <td><%= h(c.current_model_id) %></td>
            <td class="r num"><%= c.num_turns %></td>
            <td class="r num"><%= c.num_messages %></td>
            <td class="r num"><%= tok(c) %></td>
            <td class="r muted num"><%= relative_time(c.last_active_at) %></td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</section>
